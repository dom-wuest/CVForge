# ─── Sensitive data ─────────────────────────────────────────────────────────
# Real phone number and street address live here. NEVER commit this file.
# The committed data/cv-*.yaml carry placeholders only, so nothing leaks even
# if this entry is ever removed by accident.
data/private.yaml
data/private.*.yaml
!data/private.example.yaml

# The signature scan for cover letters. Its path is named only in
# data/private.yaml, which is itself ignored - so no tracked file mentions it
# even by name, and a broken rule here still leaks nothing from git history.
assets/private/

# ─── Application dossiers ───────────────────────────────────────────────────
# applications/<slug>/letter.yaml IS tracked: it is your own writing, and a
# company's postal address is public imprint data. Everything about the other
# party is not. A recruiter's name, email and phone are their personal data,
# and an archived posting is someone else's copyrighted text; neither belongs
# in a history that outlives the application.
applications/*/dossier.yaml
applications/*/posting/
!applications/_template/dossier.example.yaml

# ─── Editable diagram sources ───────────────────────────────────────────────
# draw.io exports embed their whole editable mxfile in a PNG metadata chunk.
# For resources/iVS3D_overview.png that chunk was 12.8MB against 240KB of
# actual pixels, and it does not compress (9MB even zlib-9), so the tracked PNG
# is stripped and the editable original is kept alongside it under this name.
# Keep these files - they are how the diagrams get edited.
*.drawio.png
*.drawio

# ─── Generated artifacts ────────────────────────────────────────────────────
# build/ may contain the resolved CV *with* private values merged in.
build/
out/

# ─── Python ─────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/

# ─── Editors / OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
