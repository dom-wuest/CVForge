{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CV: Build PDF (en)",
      "type": "shell",
      "command": "uv run cvforge pdf --lang en",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "CV: Build PDF (de)",
      "type": "shell",
      "command": "uv run cvforge pdf --lang de",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "CV: Build all",
      "type": "shell",
      "command": "uv run cvforge all",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "CV: Dev watch (en)",
      "detail": "Regenerates build/cv-en.json on data changes. Pair with Tinymist: Preview.",
      "type": "shell",
      "command": "uv run cvforge dev --lang en",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Letter: New application",
      "detail": "Scaffolds applications/<slug>/ from the template.",
      "type": "shell",
      "command": "uv run cvforge new ${input:slug} --lang ${input:lang}",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Letter: Build send-ready folder",
      "detail": "Letter + matching CV into <home>/applications/<slug>/send/.",
      "type": "shell",
      "command": "uv run cvforge apply ${input:slug}",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Letter: Dev watch",
      "detail": "Regenerates build/letter-preview.json. Pair with Tinymist: Preview on templates/letter/main.typ.",
      "type": "shell",
      "command": "uv run cvforge dev --letter ${input:slug}",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "CV: Check data",
      "type": "shell",
      "command": "uv run cvforge check",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "CV: Check for leaked private data",
      "type": "shell",
      "command": "uv run cvforge check-clean",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "slug",
      "type": "promptString",
      "description": "Application slug (the directory name under applications/)"
    },
    {
      "id": "lang",
      "type": "pickString",
      "options": ["de", "en"],
      "default": "de",
      "description": "Language of the letter"
    }
  ]
}
